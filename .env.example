# ============================================================
# DataPulse - Environment Configuration Template
# ============================================================

# Application
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL)
# Option A: Full Connection URL (preferred for PostgreSQL 18)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/datapulse

# Option B: Individual connection components (used if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datapulse

# Fallback: If PostgreSQL credentials are not provided or connection fails,
# DataPulse can automatically fall back to local SQLite (sqlite:///./datapulse.db)
ALLOW_SQLITE_FALLBACK=true

# AI Diagnosis Provider ("rule_based", "openai", "gemini")
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
